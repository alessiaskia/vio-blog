---
import { LOGO_IMAGE, SITE } from "@config";
import Hr from "./Hr.astro";

export interface Props {
  activeNav?: "about" | "tarifs" | "consultations" | "contact" | "actus";
}

const { activeNav } = Astro.props;
---

<header>
  <!-- Skip link -->
  <a id="skip-to-content" href="#main-content">Skip to content</a>

  <div class="nav-container">
    <div class="top-nav-wrap">
      <h1>{SITE.title}</h1>

      <!-- Hamburger for mobile -->
      <button class="hamburger-menu" aria-label="Open Menu">
        <svg viewBox="0 0 24 24" width="24" height="24">
          <line
            x1="3"
            y1="6"
            x2="21"
            y2="6"
            stroke="currentColor"
            stroke-width="2"></line>
          <line
            x1="3"
            y1="12"
            x2="21"
            y2="12"
            stroke="currentColor"
            stroke-width="2"></line>
          <line
            x1="3"
            y1="18"
            x2="21"
            y2="18"
            stroke="currentColor"
            stroke-width="2"></line>
        </svg>
      </button>

      <!-- Nav links -->
      <!-- Desktop nav (unchanged) -->
      <nav class="desktop-nav">
        <ul class="nav-links">
          <li>
            <a href="/#about" class={activeNav === "about" ? "active" : ""}
              >Qui suis‑je?</a
            >
          </li>
          <li>
            <a href="/#tarifs" class={activeNav === "tarifs" ? "active" : ""}
              >Tarifs</a
            >
          </li>
          <li>
            <a
              href="/#consultations"
              class={activeNav === "consultations" ? "active" : ""}
              >Consultations</a
            >
          </li>
          <li>
            <a href="/#contact" class={activeNav === "contact" ? "active" : ""}
              >Contact</a
            >
          </li>
        </ul>

        <!-- Theme toggle -->
        {
          SITE.lightAndDarkMode && (
            <button id="theme-btn" aria-label="Toggle Theme" class="theme-btn">
              <svg
                id="sun-svg"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
              >
                <circle cx="12" cy="12" r="5" fill="currentColor" />
                <g stroke="currentColor" stroke-width="2">
                  <line x1="12" y1="1" x2="12" y2="3" />
                  <line x1="12" y1="21" x2="12" y2="23" />
                  <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
                  <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
                  <line x1="1" y1="12" x2="3" y2="12" />
                  <line x1="21" y1="12" x2="23" y2="12" />
                  <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
                  <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
                </g>
              </svg>
              <svg
                id="moon-svg"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
              >
                <path
                  fill="currentColor"
                  d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z"
                />
              </svg>
            </button>
          )
        }
      </nav>
    </div>
  </div>
</header>

<!-- Mobile full-screen overlay -->
<nav class="mobile-nav-overlay" id="mobile-nav">
  <button class="close-menu" aria-label="Close Menu">×</button>

  <ul class="mobile-nav-links">
    <li><a href="/#about">Qui suis‑je?</a></li>
    <li><a href="/#tarifs">Tarifs</a></li>
    <li><a href="/#consultations">Consultations</a></li>
    <li><a href="/#contact">Contact</a></li>
  </ul>
</nav>

