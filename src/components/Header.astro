---
import { LOGO_IMAGE, SITE } from "@config";
import Hr from "./Hr.astro";

export interface Props {
  activeNav?: "about" | "tarifs" | "consultations" | "contact" | "actus";
}

const { activeNav } = Astro.props;
---

<header>
  <!-- Skip link -->
  <a id="skip-to-content" href="#main-content">Skip to content</a>

  <div class="nav-container">
    <div class="top-nav-wrap">
      <h1>{SITE.title}</h1>

      <!-- Hamburger for mobile -->
      <button class="hamburger-menu" aria-label="Open Menu">
        <svg viewBox="0 0 24 24" width="24" height="24">
          <line
            x1="3"
            y1="6"
            x2="21"
            y2="6"
            stroke="currentColor"
            stroke-width="2"></line>
          <line
            x1="3"
            y1="12"
            x2="21"
            y2="12"
            stroke="currentColor"
            stroke-width="2"></line>
          <line
            x1="3"
            y1="18"
            x2="21"
            y2="18"
            stroke="currentColor"
            stroke-width="2"></line>
        </svg>
      </button>

      <!-- Nav links -->
      <nav>
        <ul class="nav-links">
          <li>
            <a href="/#about" class={activeNav === "about" ? "active" : ""}
              >Qui suis-je?</a
            >
          </li>
          <li>
            <a href="/#tarifs" class={activeNav === "tarifs" ? "active" : ""}
              >Tarifs</a
            >
          </li>
          <li>
            <a
              href="/#consultations"
              class={activeNav === "consultations" ? "active" : ""}
              >Consultations</a
            >
          </li>
          <li>
            <a href="/#contact" class={activeNav === "contact" ? "active" : ""}
              >Contact</a
            >
          </li>
          <li>
            <a href="/posts" class={activeNav === "actus" ? "active" : ""}
              >Actualités</a
            >
          </li>
        </ul>

        <!-- Theme toggle -->
        {
          SITE.lightAndDarkMode && (
            <button id="theme-btn" aria-label="Toggle Theme" class="theme-btn">
              <svg
                id="sun-svg"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
              >
                <circle cx="12" cy="12" r="5" fill="currentColor" />
                <g stroke="currentColor" stroke-width="2">
                  <line x1="12" y1="1" x2="12" y2="3" />
                  <line x1="12" y1="21" x2="12" y2="23" />
                  <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
                  <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
                  <line x1="1" y1="12" x2="3" y2="12" />
                  <line x1="21" y1="12" x2="23" y2="12" />
                  <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
                  <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
                </g>
              </svg>
              <svg
                id="moon-svg"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
              >
                <path
                  fill="currentColor"
                  d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z"
                />
              </svg>
            </button>
          )
        }
      </nav>
    </div>
  </div>

  <Hr />
</header>

<style>
  /* Skip link */
  #skip-to-content {
    position: absolute;
    left: -9999px;
    top: -9999px;
    background: var(--accent);
    color: #fff;
    padding: 0.5rem 1rem;
    z-index: 100;
  }
  #skip-to-content:focus {
    left: 1rem;
    top: 1rem;
  }

  /* Nav */
  nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* Container */
  .nav-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .top-nav-wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    position: relative;
  }

  .top-nav-wrap h1 {
    /* margin-left: 20px; */
  }

  /* Logo */
  .logo img,
  .logo {
    font-size: 1.5rem;
    font-weight: 600;
    height: auto;
  }

  /* Hamburger */
  .hamburger-menu {
    display: block;
    background: none;
    border: none;
    cursor: pointer;
  }
  .hamburger-menu svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  /* Nav links */
  .nav-links {
    display: none;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .nav-links li a {
    text-decoration: none;
    padding: 0;
    font-weight: 500;
  }
  .nav-links li a.active {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .nav-links.open {
    display: flex;
  }

  /* Theme toggle */
  #sun-svg,
  #moon-svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  #moon-svg {
    display: none;
  }
  html[data-theme="dark"] #moon-svg {
    display: block;
  }
  html[data-theme="dark"] #sun-svg {
    display: none;
  }

  /* Button */
  button,
  .link-button {
    background-color: #1fe0; /* shortcut for transparent */
    color: var(--foreground);
    border: none;
    padding: 0.5rem 1rem;
    cursor: pointer;
  }

  /* Desktop layout */
  @media (min-width: 640px) {
    .hamburger-menu {
      display: none;
    }

    .nav-links {
      display: flex;
      flex-direction: row;
      gap: 2rem;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 2rem;
    }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const menuBtn = document.querySelector(".hamburger-menu");
    const navLinks = document.querySelector(".nav-links");
    menuBtn?.addEventListener("click", () => {
      navLinks.classList.toggle("open");
    });

    // Theme toggle
    const themeBtn = document.querySelector("#theme-btn");
    let themeValue = localStorage.getItem("theme") || "light";

    function reflectTheme() {
      document.documentElement.setAttribute("data-theme", themeValue);
      localStorage.setItem("theme", themeValue);
    }
    reflectTheme();

    themeBtn?.addEventListener("click", () => {
      themeValue = themeValue === "light" ? "dark" : "light";
      reflectTheme();
    });
  });
</script>
